  {
   "cell_type": "markdown",
   "id": "2913c9e7",
   "metadata": {},
   "source": [
    "### 3-5. rank-q 重建品質分析"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "dde38e18",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "=======================================================\n",
      "                  人臉重建品質摘要                   \n",
      "=======================================================\n",
      "    q |   平均 PSNR (dB) |              備注\n",
      "-------------------------------------------------------\n",
      "    1 |         18.66 |\n",
      "    5 |         20.80 |\n",
      "   10 |         22.04 |\n",
      "   20 |         23.64 |\n",
      "   50 |         26.36 |\n",
      "  100 |         29.18 |\n",
      "  200 |         34.14 | ← 首次 PSNR ≥ 30dB\n",
      "  300 |         40.90 |\n",
      "=======================================================\n",
      "\n",
      "達到平均 PSNR ≥ 30dB 需要 q = 200 個特徵向量\n"
     ]
    }
   ],
   "source": [
    "def reconstruct_faces(U, s, Vt, mean_vec, q):\n",
    "    \"\"\"\n",
    "    rank-q 人臉重建。\n",
    "\n",
    "    數學：Ã_q = U_q @ diag(s_q) @ Vt_q，重建後加回均值：A_q = Ã_q + mean_vec。\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    U : ndarray, shape (N, N)  左奇異矩陣\n",
    "    s : ndarray, shape (N,)    奇異值（降序）\n",
    "    Vt : ndarray, shape (N, 4096)  右奇異矩陣（轉置）\n",
    "    mean_vec : ndarray, shape (4096,) 或 (1, 4096)  均值臉向量\n",
    "    q : int  保留成分數\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    ndarray, shape (N, 4096)  重建後的人臉矩陣（已加回均值）\n",
    "    \"\"\"\n",
    "    A_q = U[:, :q] @ np.diag(s[:q]) @ Vt[:q, :]\n",
    "    return A_q + mean_vec   # 廣播加回均值\n",
    "\n",
    "\n",
    "q_values_f = [1, 5, 10, 20, 50, 100, 200, 300]\n",
    "psnr_stats = []\n",
    "all_psnr_data = []\n",
    "\n",
    "for q in q_values_f:\n",
    "    A_reconstructed = reconstruct_faces(U_f, s_f, Vt_f, mean_face_vec, q)\n",
    "    \n",
    "    # 向量化 PSNR 計算（加速 400 張人臉的處理）\n",
    "    clipped = np.clip(A_reconstructed, 0, 255)\n",
    "    mse_per_face = np.mean((A_faces - clipped)**2, axis=1)\n",
    "    # 避免 MSE 為 0 的情況（雖然在 rank-q 近似中極罕見）\n",
    "    psnr_vals = np.where(mse_per_face > 0, 20 * np.log10(255.0 / np.sqrt(mse_per_face)), float('inf'))\n",
    "\n",
    "    psnr_stats.append({\n",
    "        'q': q,\n",
    "        'mean': np.mean(psnr_vals),\n",
    "        'std': np.std(psnr_vals),\n",
    "        'min': np.min(psnr_vals),\n",
    "        'max': np.max(psnr_vals)\n",
    "    })\n",
    "    all_psnr_data.append(psnr_vals)\n",
    "\n",
    "avg_psnr_per_q = [s['mean'] for s in psnr_stats]\n",
    "min_psnr_per_q = [s['min'] for s in psnr_stats]\n",
    "\n",
    "# 找到平均 PSNR > 30dB 的最小 q\n",
    "q_30dB = next((s['q'] for s in psnr_stats if s['mean'] >= 30), None)\n",
    "\n",
    "# 畫圖：左圖為平均與最小值趨勢，右圖為分佈箱型圖\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
    "\n",
    "# 左圖：平均值與最小值趨勢\n",
    "axes[0].plot(q_values_f, avg_psnr_per_q, 'b-o', linewidth=2, markersize=8, label='平均 PSNR')\n",
    "axes[0].plot(q_values_f, min_psnr_per_q, 'r--x', linewidth=1.5, markersize=6, label='最小 PSNR')\n",
    "axes[0].axhline(y=30, color='gray', linestyle=':', linewidth=1.5, label='30dB 門檻')\n",
    "axes[0].set_xlabel('保留成分數 q', fontsize=11)\n",
    "axes[0].set_ylabel('PSNR (dB)', fontsize=11)\n",
    "axes[0].set_title('人臉重建品質趨勢：平均值 vs 最小值', fontsize=12, fontweight='bold')\n",
    "axes[0].legend(fontsize=10)\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# 右圖：箱型圖（Distribution）\n",
    "axes[1].boxplot(all_psnr_data, labels=q_values_f, showfliers=True)\n",
    "axes[1].axhline(y=30, color='r', linestyle=':', linewidth=1.5)\n",
    "axes[1].set_xlabel('保留成分數 q', fontsize=11)\n",
    "axes[1].set_ylabel('PSNR (dB)', fontsize=11)\n",
    "axes[1].set_title('PSNR 分佈情況 (400 張人臉)', fontsize=12, fontweight='bold')\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f\"\\n{'='*75}\")\n",
    "print(f\"{'人臉重建品質詳細摘要 (含分佈描述)':^70}\")\n",
    "print(f\"{'='*75}\")\n",
    "print(f\"{'q':>5} | {'平均 PSNR':>10} | {'標準差':>8} | {'最小值':>8} | {'最大值':>8} | {'備注'}\")\n",
    "print(f\"{'-'*75}\")\n",
    "for s in psnr_stats:\n",
    "    note = \" ← 平均達標\" if s['q'] == q_30dB else \"\"\n",
    "    # 檢查是否所有受試者都達標\n",
    "    if s['min'] >= 30 and note == \"\":\n",
    "        note = \" ← 全部達標\"\n",
    "    elif s['min'] < 30 and s['mean'] >= 30:\n",
    "        note += \" (仍有受試者 < 30dB)\"\n",
    "        \n",
    "    print(f\"  {s['q']:>3} | {s['mean']:>9.2f} | {s['std']:>8.2f} | {s['min']:>8.2f} | {s['max']:>8.2f} | {note}\")\n",
    "print(f\"{'='*75}\")\n",
    "if q_30dB:\n",
    "    print(f\"\\n結論：達到平均 PSNR ≥ 30dB 需要 q = {q_30dB}。\")\n",
    "    print(f\"但觀察分佈可知，在 q={q_30dB} 時最小值僅為 {next(s['min'] for s in psnr_stats if s['q']==q_30dB):.2f}dB，\")\n",
    "    print(f\"若要求『所有』受試者重建品質皆達 30dB，則建議 q 應提高至更高數值。\")"

   ]
  },
