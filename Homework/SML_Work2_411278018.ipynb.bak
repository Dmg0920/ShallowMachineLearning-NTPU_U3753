    "        if r < 1.1:    # 壓縮比低於 1.1 沒有意義\n",
    "            break\n",
    "        \n",
    "        # 利用快取重建\n",
    "        patch_rec = U_p[:, :q] @ np.diag(s_p[:q]) @ Vt_p[:q, :] + patch_mean\n",
    "        img_rec = np.clip(reconstruct_from_patches(patch_rec, meta, p), 0, 255)\n",
    "        ratios_curve.append(r)\n",
